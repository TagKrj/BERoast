# ==================================================
# SERVER
# ==================================================
PORT=5001
NODE_ENV=development

CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5001
CORS_ORIGINS=http://localhost:5173

FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/github/callback
FRONTEND_LOCAL_AUTH_CALLBACK_URL=http://localhost:5173/auth/github/callback


# ==================================================
# DATABASE - USER MUST REPLACE
# ==================================================
MONGO_URI=replace_with_your_mongodb_connection_string


# ==================================================
# JWT - USER MUST REPLACE
# Generate with: openssl rand -hex 32
# ==================================================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d


# ==================================================
# GITHUB OAUTH - USER MUST REPLACE
# Production/deployed OAuth application
# ==================================================
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback


# Local GitHub OAuth application
GITHUB_LOCAL_CLIENT_ID=replace_with_local_github_oauth_client_id
GITHUB_LOCAL_CLIENT_SECRET=replace_with_local_github_oauth_client_secret
GITHUB_LOCAL_CALLBACK_URL=http://localhost:5001/api/auth/github/callback


# Optional, but recommended to avoid GitHub API rate limits
GITHUB_TOKEN=replace_with_your_github_personal_access_token


# ==================================================
# AI PROVIDERS
# ==================================================
# User must provide their own Gemini API key
GEMINI_API_KEY=replace_with_your_gemini_api_key

# System model configuration
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# OpenAI API key is not stored here.
# Users provide their personal OpenAI key through the analyze API.


# ==================================================
# REPOSITORY ANALYSIS CONFIGURATION
# ==================================================
ANALYSIS_MAX_PRIORITY_FILES=120
ANALYSIS_MAX_FILE_BYTES=80000
ANALYSIS_FETCH_CONCURRENT=5

ANALYSIS_MAX_CONCURRENT=2
ANALYSIS_DETECTION_BATCH_SIZE=2
ANALYSIS_DOMAIN_MAX_FILES=120

ALLOW_SYSTEM_AI_FOR_LARGE=true
DAILY_ANALYSIS_LIMIT=100


# ==================================================
# AI REQUEST CONFIGURATION
# ==================================================
LLM_RETRY_COUNT=8
LLM_RETRY_DELAY_MS=2500
LLM_REQUEST_TIMEOUT_MS=120000